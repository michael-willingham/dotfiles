# ------------------------------------------------------------------------------
# Powerlevel10k instant prompt
# Must stay near the top. Anything that can prompt belongs above this block.
# ------------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------
export EDITOR=nvim
export LANG=en_US.UTF-8
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"
export ZSH="$HOME/.oh-my-zsh"

# ------------------------------------------------------------------------------
# Homebrew
# Load brew first so later plugin/theme paths can use HOMEBREW_PREFIX.
# ------------------------------------------------------------------------------
_load_homebrew() {
  if (( $+commands[brew] )); then
    eval "$(brew shellenv)"
    return 0
  fi

  local candidate
  for candidate in \
    /opt/workbrew/bin/brew \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew \
    /home/linuxbrew/.linuxbrew/bin/brew \
    "$HOME/.linuxbrew/bin/brew"; do
    if [[ -x $candidate ]]; then
      eval "$("$candidate" shellenv)"
      return 0
    fi
  done

  return 1
}

_source_brew_share() {
  local file="$1"
  [[ -n ${HOMEBREW_PREFIX:-} && -r $HOMEBREW_PREFIX/share/$file ]] || return 1
  source "$HOMEBREW_PREFIX/share/$file"
}

_load_homebrew
unfunction _load_homebrew

# ------------------------------------------------------------------------------
# Oh My Zsh
# ------------------------------------------------------------------------------
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 1

CASE_SENSITIVE="true"
COMPLETION_WAITING_DOTS="true"

plugins=(
  brew
  chezmoi
  dotnet
  git
  git-auto-fetch
  golang
  kubectl
  macos
  mise
  uv
  web-search
  zoxide
)

source "$ZSH/oh-my-zsh.sh"

# ------------------------------------------------------------------------------
# Integrations
# ------------------------------------------------------------------------------
# Orbstack, macOS only.
if [[ $OSTYPE == darwin* && -r $HOME/.orbstack/shell/init.zsh ]]; then
  source "$HOME/.orbstack/shell/init.zsh"
fi

# Upgrade mise itself and installed tools at most once a day, in the background.
# Set MISE_AUTO_UP=0 to disable. Override the interval with MISE_AUTO_UP_HOURS.
_mise_auto_up() {
  emulate -L zsh
  setopt extended_glob

  [[ -o interactive ]] || return 0
  [[ ${MISE_AUTO_UP:-1} == 0 ]] && return 0
  (( $+commands[mise] )) || return 0

  local stamp="${XDG_CACHE_HOME:-$HOME/.cache}/mise/auto-up.stamp"
  local hours="${MISE_AUTO_UP_HOURS:-24}"

  mkdir -p "${stamp:h}"
  if [[ -f $stamp && -z $stamp(#qN.mh+${hours}) ]]; then
    return 0
  fi

  touch "$stamp"
  {
    command mise self-update -y
    command mise up -y
  } </dev/null >/dev/null 2>&1 &!
}

_mise_auto_up
unfunction _mise_auto_up

# ------------------------------------------------------------------------------
# Aliases
# ------------------------------------------------------------------------------
alias c="chezmoi"
alias cat="bat"
alias cd="z"
alias cls="clear"
alias e="exit"
alias ff="fastfetch"
alias ls="eza -lh --icons"
alias nsmi="nvidia-smi"
alias tf="terraform"

# ------------------------------------------------------------------------------
# Extra zsh plugins
# ------------------------------------------------------------------------------
_source_brew_share zsh-you-should-use/you-should-use.plugin.zsh
_source_brew_share zsh-autosuggestions/zsh-autosuggestions.zsh

# ------------------------------------------------------------------------------
# Prompt
# ------------------------------------------------------------------------------
_source_brew_share powerlevel10k/powerlevel10k.zsh-theme
[[ -r $HOME/.p10k.zsh ]] && source "$HOME/.p10k.zsh"

# Syntax highlighting must be sourced last.
_source_brew_share zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
unfunction _source_brew_share
